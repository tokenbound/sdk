{
	"name": "tokenbound-monorepo",
	"version": "0.0.0",
	"description": "",
	"scripts": {
		"build": "pnpm --filter @tokenbound/sdk build && pnpm --filter @tokenbound/ethers build",
		"test": "pnpm --filter @tokenbound/sdk test && pnpm --filter @tokenbound/ethers test",
		"test:unit": "pnpm --filter @tokenbound/sdk exec vitest --watch=false --typecheck run src/test/unit/",
		"typecheck": "pnpm --filter @tokenbound/sdk exec tsc --noEmit && pnpm --filter @tokenbound/ethers exec tsc --noEmit",
		"validate:packages": "node scripts/validate-package-contents.mjs",
		"clean": "rm -rf node_modules",
		"prepare": "husky install",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"format": "biome format .",
		"format:fix": "biome format --write ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@changesets/cli": "^2.26.2",
		"husky": "^8.0.3",
		"typescript": "^5.6.3"
	}
}
