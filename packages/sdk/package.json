{
	"name": "@tokenbound/sdk",
	"version": "0.5.5",
	"type": "module",
	"files": ["dist"],
	"types": "./dist/src/index.d.ts",
	"main": "./dist/tokenbound-sdk.umd.cjs",
	"module": "./dist/tokenbound-sdk.js",
	"exports": {
		".": {
			"import": {
				"types": "./dist/src/index.d.ts",
				"default": "./dist/tokenbound-sdk.js"
			},
			"require": {
				"types": "./dist/src/index.d.cts",
				"default": "./dist/tokenbound-sdk.umd.cjs"
			}
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest --watch=false",
		"coverage": "vitest run --coverage",
		"clean": "rm -rf node_modules/ dist/",
		"wagmi": "wagmi generate",
		"prep": "pnpm clean && pnpm i && pnpm wagmi && pnpm build",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"format": "biome format .",
		"format:fix": "biome format --write ."
	},
	"dependencies": {
		"@layerzerolabs/lz-v2-utilities": "^3.0.168",
		"viem": "~2.55.19"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@tanstack/react-query": "^5.102.4",
		"@microsoft/api-extractor": "^7.59.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.6",
		"@tokenbound/sdk": "workspace:^",
		"@types/react": "^19.2.18",
		"@viem/anvil": "^0.0.10",
		"@vitest/coverage-v8": "^4.1.11",
		"@wagmi/cli": "^2.10.0",
		"forge-std": "1.1.2",
		"jsdom": "^30.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "^5.9.3",
		"viem": "~2.55.19",
		"wagmi": "~3.7.6",
		"vite": "^8.2.2",
		"vite-plugin-dts": "^5.0.3",
		"vitest": "^4.1.11",
		"rollup-plugin-visualizer": "^7.1.1"
	}
}
