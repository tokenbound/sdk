{
	"name": "@tokenbound/sdk",
	"version": "0.5.5",
	"description": "Viem-first SDK for interacting with ERC-6551 tokenbound accounts.",
	"keywords": [
		"ethereum",
		"erc6551",
		"erc-6551",
		"tokenbound",
		"nft",
		"viem",
		"web3"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tokenbound/sdk.git",
		"directory": "packages/sdk"
	},
	"homepage": "https://github.com/tokenbound/sdk/tree/main/packages/sdk#readme",
	"bugs": {
		"url": "https://github.com/tokenbound/sdk/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"viem": [
				"./dist/viem.d.ts"
			],
			"protocol": [
				"./dist/protocol.d.ts"
			]
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./viem": {
			"import": {
				"types": "./dist/viem.d.ts",
				"default": "./dist/viem.js"
			},
			"require": {
				"types": "./dist/viem.d.cts",
				"default": "./dist/viem.cjs"
			}
		},
		"./protocol": {
			"import": {
				"types": "./dist/protocol.d.ts",
				"default": "./dist/protocol.js"
			},
			"require": {
				"types": "./dist/protocol.d.cts",
				"default": "./dist/protocol.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc && tsdown",
		"test": "pnpm typecheck && vitest --watch=false",
		"coverage": "vitest run --coverage",
		"clean": "rm -rf node_modules/ dist/",
		"wagmi": "wagmi generate",
		"prep": "pnpm clean && pnpm i && pnpm wagmi && pnpm build",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
	},
	"dependencies": {
		"@layerzerolabs/lz-v2-utilities": "^3.0.168"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@tokenbound/test-fixtures": "workspace:*",
		"@vitest/coverage-v8": "^1.6.1",
		"@wagmi/cli": "^2.10.0",
		"rollup-plugin-visualizer": "^5.12.0",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"viem": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"viem": "^2.57.7"
	}
}
