{
	"name": "@tokenbound/sdk",
	"version": "0.5.5",
	"description": "Viem-first SDK for interacting with ERC-6551 tokenbound accounts.",
	"keywords": [
		"ethereum",
		"erc6551",
		"erc-6551",
		"tokenbound",
		"nft",
		"viem",
		"web3"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tokenbound/sdk.git",
		"directory": "packages/sdk"
	},
	"homepage": "https://github.com/tokenbound/sdk/tree/main/packages/sdk#readme",
	"bugs": {
		"url": "https://github.com/tokenbound/sdk/issues"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"types": "./dist/src/index.d.ts",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./viem": {
			"types": "./dist/src/viem/index.d.ts",
			"import": "./dist/viem.js",
			"require": "./dist/viem.cjs"
		},
		"./protocol": {
			"types": "./dist/src/protocol/index.d.ts",
			"import": "./dist/protocol.js",
			"require": "./dist/protocol.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest --watch=false",
		"coverage": "vitest run --coverage",
		"clean": "rm -rf node_modules/ dist/",
		"wagmi": "wagmi generate",
		"prep": "pnpm clean && pnpm i && pnpm wagmi && pnpm build",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"format": "biome format .",
		"format:fix": "biome format --write ."
	},
	"dependencies": {
		"@layerzerolabs/lz-v2-utilities": "^3.0.168",
		"viem": "~2.56.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@tokenbound/test-fixtures": "workspace:*",
		"@viem/anvil": "^0.0.10",
		"@vitest/coverage-v8": "^1.6.1",
		"@wagmi/cli": "^2.10.0",
		"rollup-plugin-visualizer": "^5.12.0",
		"typescript": "^5.4.5",
		"viem": "~2.56.6",
		"vite": "^4.4.9",
		"vite-plugin-dts": "^3.9.0",
		"vitest": "^1.6.0"
	}
}
